<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/colorBackground"
    android:padding="@dimen/verdict_padding">

    <LinearLayout
        android:id="@+id/verdictContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_large"
        android:layout_margin="@dimen/verdict_margin">

        <!-- Verdict Text -->
        <TextView
            android:id="@+id/verdictText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_verdict"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- Gilet Info -->
        <TextView
            android:id="@+id/giletInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_medium"
            android:textColor="@color/textOnLight"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- Details -->
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_medium">

            <TextView
                android:id="@+id/flottabiliteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_medium"
                android:textColor="@color/textOnLight" />

            <TextView
                android:id="@+id/deltaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_medium"
                android:textColor="@color/textOnLight"
                android:layout_marginTop="@dimen/spacing_small" />

            <TextView
                android:id="@+id/timestampText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_small"
                android:textColor="@color/textOnLight"
                android:layout_marginTop="@dimen/spacing_small" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/spacing_large">

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:text="Enregistrer"
            style="@style/Widget.TestGilets.Button.Success"
            android:layout_marginEnd="@dimen/spacing_medium" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:text="Annuler"
            style="@style/Widget.TestGilets.Button.Secondary"
            android:layout_marginStart="@dimen/spacing_medium" />
    </LinearLayout>

</LinearLayout>
