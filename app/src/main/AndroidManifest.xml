<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- L'app est HORS LIGNE : aucune permission Internet. -->
    <!-- La caméra est demandée par zxing-android-embedded au moment du scan. -->

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.TestGilets"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activité de scan zxing (thème plein écran, gérée par la lib). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation"
            xmlns:tools="http://schemas.android.com/tools" />
    </application>
</manifest>


