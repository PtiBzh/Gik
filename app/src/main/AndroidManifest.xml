<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="fr.ydel.gilets">

    <application
        android:name=".TestGiletsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Test gilets"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestGilets"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Test gilets"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.SessionActivity"
            android:exported="false"
            android:label="Session"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Réglages"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.VerdictActivity"
            android:exported="false"
            android:label="Verdict"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.TestGilets.Verdict" />
        <activity
            android:name=".ui.ScanActivity"
            android:exported="false"
            android:label="Scan"
            android:parentActivityName=".ui.MainActivity" />
    </application>

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

</manifest>
